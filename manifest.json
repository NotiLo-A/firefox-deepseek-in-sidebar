{
  "manifest_version": 2,
  "name": "Kimi.AI in Sidebar",
  "description": "Displays Kimi AI assistant in the Firefox sidebar with customizable shortcuts.",
  "version": "1.0.0",
  "author": "Niobium62",
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": "default-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; script-src 'self'; connect-src 'self' https://www.kimi.ai/; frame-src https://www.kimi.ai/; img-src 'self' data: https:;",
  "options_ui": {
    "page": "src/options/options.html",
    "browser_style": false,
    "open_in_tab": false
  },
  "sidebar_action": {
    "default_icon": {
      "16": "src/icons/icon.svg",
      "32": "src/icons/icon.svg",
      "192": "src/icons/icon.svg"
    },
    "default_title": "Kimi",
    "default_panel": "src/sidebar/panel.html",
    "browser_style": false
  },
  "icons": {
    "16": "src/icons/icon.svg",
    "32": "src/icons/icon.svg",
    "192": "src/icons/icon.svg"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle the Kimi sidebar."
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "src/icons/icon.svg",
      "32": "src/icons/icon.svg"
    },
    "default_title": "Toggle Kimi Sidebar",
    "browser_style": false
  }
}