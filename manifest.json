{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "3.0.1",
  "author": "NotiLo-A",
  "homepage_url": "https://github.com/NotiLo-A/firefox-deepseek-in-sidebar",
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{43c6e9ce-a86a-4601-bbce-1e3608546335}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; img-src 'self' data: https:;"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "sidebar_action": {
    "default_icon": {
      "16": "src/icons/deepseek-16x16.png",
      "32": "src/icons/deepseek-32x32.png",
      "48": "src/icons/deepseek-48x48.png"
    },
    "default_title": "__MSG_sidebarTitle__",
    "default_panel": "src/sidebar/panel.html"
  },
  "action": {
    "default_icon": {
      "16": "src/icons/deepseek-16x16.png",
      "32": "src/icons/deepseek-32x32.png",
      "48": "src/icons/deepseek-48x48.png"
    },
    "default_title": "__MSG_toggleSidebarTitle__"
  },
  "icons": {
    "16": "src/icons/deepseek-16x16.png",
    "32": "src/icons/deepseek-32x32.png",
    "48": "src/icons/deepseek-48x48.png",
    "96": "src/icons/deepseek-96x96.png",
    "192": "src/icons/deepseek-192x192.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_toggleSidebarCommand__"
    }
  }
}
